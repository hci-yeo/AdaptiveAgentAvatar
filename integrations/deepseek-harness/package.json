{
  "name": "@local/ai-avatar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The same AI avatar as the Doubao, Codex and Yuanbao mods: an expert beside the message box, picked by the topic of each question, who walks out and in when it changes and reacts while DSH answers.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.webp"
  },
  "files": [
    "index.js",
    "local-model.js",
    "model-worker.js",
    "media.js",
    "pet.js",
    "media/*.webm",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.webp"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
